# ─── Client (.env.local) — Square Web Payments SDK ────────────────────
# Safe to expose: these identify the app/location, they are NOT secrets.
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# ─── Client (.env.local) — Firebase ───────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCzByJ-ZWsY6tDuNh0wFrG7ESxualcVNGo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=animas-reflections-pwa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=animas-reflections-pwa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=animas-reflections-pwa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=508402195460
NEXT_PUBLIC_FIREBASE_APP_ID=1:508402195460:web:17ab83e8a71c79232c2951

# ─── Client (.env.local) — Admin Email (CMS portal access control) ────
NEXT_PUBLIC_ADMIN_EMAIL=

# ─── Client (.env.local) — Shipping Tiers ─────────────────────────────
NEXT_PUBLIC_SHIPPING_TIER_STICKERS=3.00
NEXT_PUBLIC_SHIPPING_TIER_APPAREL=7.50
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=100.00

# ─── Cloud Functions (functions/.env — NEVER expose in client code) ───
# Server-side Square secrets used by functions/src/index.ts params:
#   SQUARE_ACCESS_TOKEN=
#   SQUARE_ENVIRONMENT=sandbox
#   SQUARE_LOCATION_ID=
# Optional first-run admin bootstrap:
#   BOOTSTRAP_ADMIN_EMAIL=
