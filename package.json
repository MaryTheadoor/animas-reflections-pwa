{
  "name": "animas-reflections-pwa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "og": "node scripts/generate-og.mjs",
    "seo:fetch": "node scripts/fetch-seo-config.mjs",
    "prebuild": "node scripts/fetch-seo-config.mjs && node scripts/generate-og.mjs",
    "publish": "npm run build && firebase deploy --only hosting",
    "build": "next build",
    "check:seo": "node scripts/check-seo.mjs",
    "postbuild": "node scripts/check-seo.mjs",
    "build:all": "npm run build && cd functions && npm run build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test",
    "emulators": "firebase emulators:start",
    "deploy": "firebase deploy",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "backup:file": "powershell -ExecutionPolicy Bypass -File scripts/backup-file.ps1",
    "backup:commit": "powershell -ExecutionPolicy Bypass -File scripts/backup-commit.ps1",
    "backup:snapshot": "powershell -ExecutionPolicy Bypass -File scripts/snapshot-full.ps1",
    "backup:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore.ps1",
    "backup:list": "powershell -ExecutionPolicy Bypass -File scripts/restore.ps1 -List"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "firebase": "^12.14.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  }
}
