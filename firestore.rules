rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Site config - public read, authenticated write
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Design catalog - public read, authenticated write
    match /designs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Products - public read, authenticated write
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Categories - public read, authenticated write
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles - authenticated users can read/write their own doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User-submitted orders reference - write via Functions only
    match /orders/{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
