rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check: emails stored in config/admin by the saveAdminEmails function.
    // Used by the admin dashboard to list all users.
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/admin)
        && (request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admin).data.emails
            // Tolerate legacy docs whose emails were stored un-normalized.
            || request.auth.token.email in get(/databases/$(database)/documents/config/admin).data.emails);
    }

    // Site config - public read, admin-only write
    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin email list - admin-only (it grants admin powers; keep it private)
    match /config/admin {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Any other config doc - public read, admin-only write.
    // NOTE: this is a SINGLE-segment match, not /config/{document=**}. Firestore
    // ORs every matching rule, so the previous recursive wildcard also matched
    // config/admin and its "allow read: if true" silently overrode the
    // admin-only rule below — the admin email list was readable anonymously
    // (verified: an unauthenticated GET of config/admin returned HTTP 200).
    // Excluding 'admin' here keeps config/site and config/seo public while
    // leaving config/admin guarded by its own rule. Do not widen this back.
    match /config/{docId} {
      allow read: if docId != 'admin';
      allow write: if isAdmin();
    }

    // Design catalog - public read, admin-only write
    match /designs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products - public read, admin-only write
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories - public read, admin-only write
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles - users read/write their own doc; admins may read all
    // (admin dashboard Users tab lists the collection).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Orders - read only by the customer who placed it OR an admin; writes via Functions only.
    // Email matching is case-insensitive via the normalized customerEmailLower key
    // (legacy docs without the field fall back to the exact-case comparison).
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || request.auth.token.email == resource.data.customerEmail
        || ('customerEmailLower' in resource.data && request.auth.token.email.lower() == resource.data.customerEmailLower)
      );
      allow write: if false;  // Functions only (admin SDK bypasses rules)
    }

    // Customer profiles - authenticated users read/write their own
    match /customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /addresses/{addressId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Server-only secrets (e.g. the GitHub publish token). No client may read or
    // write these; Cloud Functions use the Admin SDK, which bypasses rules.
    // Stored here rather than in Secret Manager because functions v2's
    // defineSecret() FAILS THE DEPLOY when the secret does not yet exist, which
    // would block `firebase deploy --only functions` until someone creates it.
    match /secrets/{docId} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
