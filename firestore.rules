rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Site config - public read, authenticated write
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Design catalog - public read, authenticated write
    match /designs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Products - public read, authenticated write
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Categories - public read, authenticated write
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles - authenticated users can read/write their own doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders - authenticated users can read their own orders; writes via Functions only
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if false;  // Functions only (admin SDK bypasses rules)
    }

    // Customer profiles - authenticated users read/write their own
    match /customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /addresses/{addressId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
