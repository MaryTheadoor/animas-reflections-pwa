rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check: emails stored in config/admin by the saveAdminEmails function.
    // Used by the admin dashboard to list all users.
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/admin)
        && request.auth.token.email in get(/databases/$(database)/documents/config/admin).data.emails;
    }

    // Site config - public read, authenticated write
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Design catalog - public read, authenticated write
    match /designs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Products - public read, authenticated write
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Categories - public read, authenticated write
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles - users read/write their own doc; admins may read all
    // (admin dashboard Users tab lists the collection).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Orders - authenticated users can read their own orders; writes via Functions only
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if false;  // Functions only (admin SDK bypasses rules)
    }

    // Customer profiles - authenticated users read/write their own
    match /customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /addresses/{addressId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
