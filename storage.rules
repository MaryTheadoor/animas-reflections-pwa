rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Design catalog assets - public read, authenticated write
    match /designs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User-uploaded custom logos for orders - write allowed for authenticated
    match /uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Product images - public read, authenticated write (admin-only in practice via UI auth guard)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
