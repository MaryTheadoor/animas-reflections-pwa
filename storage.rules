rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Admin authorization for Storage ────────────────────────────────
    // Cloud Storage security rules CANNOT read Cloud Firestore in this
    // project. Cross-service firestore.exists()/firestore.get() was verified
    // against the live bucket on 2026-09-16 and returns false for EVERY
    // Firestore path — including public-read documents such as config/site and
    // products/{id}. The previous implementation (firestore.exists(config/admin)
    // + firestore.get(...).data.emails.hasAny([...])) therefore evaluated to
    // false for genuine admins and every admin image upload failed with
    // storage/unauthorized. DO NOT reintroduce firestore.* here.
    //
    // Admin status is derived from the request itself instead:
    //   1. the `admin` custom claim, minted by the syncAdminClaims and
    //      syncMyAdminClaim Cloud Functions and re-synced by saveAdminEmails —
    //      so an admin added through Admin → Admins starts working on their
    //      next sign-in with no rules redeploy; and
    //   2. a bootstrap list of founder emails, so uploads work immediately and
    //      keep working even before any claim has been minted.
    // Only a change to a founder email requires editing and redeploying this
    // file. `config/admin` remains the source of truth for everything else.
    // email_verified is required as well as the address: without it an account
    // could be created against a listed address and inherit admin Storage
    // access. Both founder accounts are Google sign-ins, so this is already true
    // for them (verified against the live Auth records, 2026-09-16).
    function isBootstrapAdmin() {
      return request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() in [
          'animasreflections@gmail.com',
          'mary.theadoor.doctor@gmail.com'
        ];
    }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.get('admin', false) == true || isBootstrapAdmin());
    }

    // Design catalog assets - public read, admin-only write
    match /designs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer-uploaded designs for orders. Only the uploader may create or
    // view them; admins may view them for fulfillment.
    match /uploads/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Product images - public read, admin-only write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product photo library - reusable blank-product photos (see
    // firestore.rules /product_photos). Public read, admin-only write.
    match /product-photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
