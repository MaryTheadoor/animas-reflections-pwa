rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors the Firestore isAdmin() check: an email present in config/admin.
    // Both the normalized (lowercase) and the stored form are accepted so
    // legacy config docs keep working until re-saved via the Admin UI.
    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/config/admin)
        && firestore.get(/databases/(default)/documents/config/admin).data.emails.hasAny([
          request.auth.token.email.lower(),
          request.auth.token.email
        ]);
    }

    // Design catalog assets - public read, admin-only write
    match /designs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer-uploaded designs for orders. Only the uploader may create or
    // view them; admins may view them for fulfillment.
    match /uploads/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Product images - public read, admin-only write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
